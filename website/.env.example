# Copy this file to .env and fill in real values before the site goes live.
# Vite only exposes variables that start with VITE_ to the browser.

# Where the contact form sends each message (a POST with JSON). If this is left empty,
# the form keeps messages in the browser and logs them, which is fine for local work.
VITE_CONTACT_ENDPOINT=

# The email address shown in the contact section and in the thank-you message.
VITE_CONTACT_EMAIL=hello@corewise.com
