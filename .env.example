# Copy this file to .env (same folder) and fill in real values. Git ignores .env, so
# secrets never get committed. docker compose reads this automatically.

# ---- Database ----
DB_NAME=modernization
DB_USER=modernization_app
# Pick a strong password. The database is private to the compose network.
DB_PASSWORD=change-me-to-a-strong-password

# ---- Sign-in tokens ----
# Must be at least 32 characters. Generate a random one and keep it secret.
APP_JWT_SECRET=change-me-to-a-long-random-secret-of-32-plus-chars

# ---- First admin account ----
# Used once, only if the users table is empty, to create the first admin.
APP_ADMIN_EMAIL=admin@yourbank.example
APP_ADMIN_PASSWORD=change-me
APP_ADMIN_NAME=Admin

# ---- AI reading service ----
# provider is "openai" or "claude". For OpenRouter, use the openai settings with the
# OpenRouter base URL and an OpenRouter model name.
APP_AI_PROVIDER=openai
APP_AI_OPENAI_API_KEY=your-openrouter-or-openai-key
APP_AI_OPENAI_BASE_URL=https://openrouter.ai/api
APP_AI_OPENAI_MODEL=openai/gpt-4o-mini
# Only needed if you set APP_AI_PROVIDER=claude:
APP_AI_CLAUDE_API_KEY=
APP_AI_CLAUDE_MODEL=claude-3-5-sonnet-latest

# ---- CORS ----
# The origin the internal frontend is served from. With this compose file that is
# http://localhost:8081 locally, or your real internal URL in production.
APP_CORS_ORIGINS=http://localhost:8081
